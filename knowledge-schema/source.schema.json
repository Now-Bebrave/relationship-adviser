{
  "title": "Source Card",
  "type": "object",
  "required": ["title", "type", "source", "evidence_level", "confidence", "application", "limits"],
  "properties": {
    "title": {"type": "string"},
    "type": {"enum": ["book", "paper", "video", "case", "personal"]},
    "source": {"type": "string"},
    "evidence_level": {"enum": ["L1", "L2", "L3", "L4"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "application": {"type": "array"},
    "limits": {"type": "array"}
  }
}
